# 蒲公英（Pgyer）备通道密钥模板 —— 复制为 adbswitch/pgyer.properties 后填入真实值。
# 此文件不含真实密钥，可安全入库；adbswitch/pgyer.properties 本身已被根 .gitignore 忽略，不入库。
# 构建时由 adbswitch/app/build.gradle.kts 读取，经 BuildConfig 注入：
#   BuildConfig.PGYER_API_KEY / BuildConfig.PGYER_APP_KEY。
# 缺 pgyer.properties 时蒲公英通道自动降级（仅 GitHub 通道生效），不影响构建。
PGYER_API_KEY=
PGYER_APP_KEY=
