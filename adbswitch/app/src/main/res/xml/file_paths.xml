<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 更新 APK 下载到 getExternalFilesDir(Environment.DIRECTORY_DOWNLOADS)，
         这里必须与该目录严格对应，否则 FileProvider.getUriForFile 会抛 IllegalArgumentException。 -->
    <external-files-path
        name="updates"
        path="Download" />
    <!-- UpdateDownloader.targetDir 的兜底目录：外部存储不可用时退回 cacheDir/download，
         不声明这条路径时 FileProvider.getUriForFile 会直接抛 IllegalArgumentException 崩溃。 -->
    <cache-path
        name="cache_dl"
        path="download" />
</paths>
