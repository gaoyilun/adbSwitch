<?xml version="1.0" encoding="utf-8"?>
<!-- 状态栏/通知/磁贴图标：与启动图标同款的「甲虫 + 开关拨钮」单色版（白，系统会自动着色/剪影化）。
     VectorDrawable 的 <group> 不支持画笔属性，每条 path 各自携带 stroke/fill。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 甲虫触角 -->
    <path
        android:strokeWidth="1.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M10.9,3.9 L9.6,2.2 M13.1,3.9 L14.4,2.2" />
    <!-- 甲虫头 -->
    <path
        android:strokeWidth="1.2"
        android:strokeColor="#FFFFFFFF"
        android:fillColor="#00000000"
        android:pathData="M10.3,5.2 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0" />
    <!-- 甲虫身体 -->
    <path
        android:strokeWidth="1.2"
        android:strokeColor="#FFFFFFFF"
        android:fillColor="#00000000"
        android:pathData="M8.6,10.6 a3.4,4 0 1,0 6.8,0 a3.4,4 0 1,0 -6.8,0" />
    <!-- 背部中线 -->
    <path
        android:strokeWidth="1.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M12,8 L12,13.8" />
    <!-- 六条腿 -->
    <path
        android:strokeWidth="1.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M8.8,8.6 L6.2,7.2 M8.6,10.6 L5.4,10.6 M8.8,12.6 L6.2,14 M15.2,8.6 L17.8,7.2 M15.4,10.6 L18.6,10.6 M15.2,12.6 L17.8,14" />
    <!-- 开关拨轨 -->
    <path
        android:strokeWidth="1.2"
        android:strokeColor="#FFFFFFFF"
        android:fillColor="#00000000"
        android:pathData="M8.1,17.2 H15.9 A2.6,2.6 0 0,1 15.9,22.4 H8.1 A2.6,2.6 0 0,1 8.1,17.2 Z" />
    <!-- 拨钮（实心） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.6,19.8 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0" />
</vector>
