<resources>
    <!-- 夜间：继承同一 M3 动态主题，颜色角色经 Dynamic 主题按壁纸派生（暗色档）。
         此处仅把状态栏图标切为浅色（日间覆盖里设了 true）。
         必须声明与日间相同的 parent，否则夜间会丢失 M3 动态主题继承。 -->
    <style name="AppTheme" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- 夜间：导航栏同色 surface；图标用浅色（windowLightNavigationBar 默认 false）。
             API 35+ edge-to-edge 下颜色被忽略，仅作低版本一致性。 -->
        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>
</resources>
