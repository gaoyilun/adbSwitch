<?xml version="1.0" encoding="utf-8"?>
<!-- 「管理开关项」弹窗的宽行：首行=标题+右侧拖动柄；次行=显示/跟随两个带完整文案的复选框。
     （单行放两个复选框会把「显示 / 跟随主开关」的文字挤没，用户不知道开关含义——故两行布局。） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/manage_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/manage_shown_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manage_shown" />

            <CheckBox
                android:id="@+id/manage_follow_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/manage_follow" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/manage_drag"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/manage_drag_desc"
        android:scaleType="center"
        android:src="@drawable/ic_drag_handle" />
</LinearLayout>
