<?xml version="1.0" encoding="utf-8"?>
<!-- WRITE_SECURE_SETTINGS 一次性授权引导的内容视图。
     为何不用 setItems：标准 AlertDialog 的 setItems 与 setMessage 同时使用时，列表项在本App
     的弹窗里不呈现为可点条目（观感是纯文字、点了不回调）；且 AlertDialog 最多只支持三个按钮，
     放不下「root / Shizuku / 复制adb命令 / 取消」四个动作。故改为自定义视图 + 真实按钮。

     按钮用 MaterialButton + borderlessButtonStyle（M3 主题下即文字按钮）：与 MaterialAlertDialog
     自身的按钮观感一致，2×2 网格里也不会被填充色块抢走正文的注意力。四个动作分两行：
     单行四个中文标签在窄屏会被压扁到不可读；第二行补 8dp 上间距，避免两行贴在一起。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/wss_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp" />

    <!-- 授权命令：等宽字体 + 可选中（长按也能手动复制，不只依赖按钮） -->
    <TextView
        android:id="@+id/wss_cmd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?android:attr/listDivider"
        android:padding="10dp"
        android:textColor="?attr/colorOnSurface"
        android:textIsSelectable="true"
        android:textSize="12sp"
        android:typeface="monospace" />

    <!-- 第一行：两种「本机代跑」（无需电脑，只需设备已有 root / Shizuku 任一） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_wss_root"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/auth_bootstrap_via_root"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_wss_shizuku"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/auth_bootstrap_via_shizuku"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 第二行：手动 adb（复制到电脑终端执行）与取消 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_wss_copy"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/auth_bootstrap_copy"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_wss_cancel"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@android:string/cancel"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
