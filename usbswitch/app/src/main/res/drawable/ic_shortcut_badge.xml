<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 调试图标（bug）：统一品牌蓝描边，放在白底角标上表达「本 App 负责调试开关」。
         VectorDrawable 的 <group> 不支持 strokeColor/strokeWidth/fillColor（仅支持变换），
         所以每条 <path> 必须各自携带画笔属性，否则渲染为全透明 → 只剩白圆。 -->
    <!-- 身体 -->
    <path
        android:strokeWidth="1.6"
        android:strokeColor="#1565C0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M7 13 a5 5.5 0 1 0 10 0 a5 5.5 0 1 0 -10 0 Z" />
    <!-- 头 -->
    <path
        android:strokeWidth="1.6"
        android:strokeColor="#1565C0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M10 6 a2 2 0 1 0 4 0 a2 2 0 0 0 -4 0 Z" />
    <!-- 触角 -->
    <path
        android:strokeWidth="1.6"
        android:strokeColor="#1565C0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M10.5 4.5 L9 2 M13.5 4.5 L15 2" />
