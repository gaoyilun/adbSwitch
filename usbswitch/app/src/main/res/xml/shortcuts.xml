<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 快捷方式 1：一键开关调试（主开关语义），执行完直接退出，不打开界面 -->
    <shortcut
        android:shortcutId="toggle_master"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_toggle_short"
        android:shortcutLongLabel="@string/sc_toggle_long">
        <intent
            android:action="com.elleng.usbdebug.action.TOGGLE_MASTER"
            android:targetPackage="com.elleng.usbdebug"
            android:targetClass="com.elleng.usbdebug.MainActivity" />
    </shortcut>

    <!-- 快捷方式 2：直接打开主页。用独立 action 标记（纯字符串，无 extra 类型歧义），
         MainActivity 见到该 action 就跳过联动自动跳转，
         所以开启联动模式后依然能进主页改设置。 -->
    <shortcut
        android:shortcutId="open_home"
        android:enabled="true"
        android:icon="@drawable/ic_home"
        android:shortcutShortLabel="@string/sc_open_home_short"
        android:shortcutLongLabel="@string/sc_open_home_long">
        <intent
            android:action="com.elleng.usbdebug.action.OPEN_HOME"
            android:targetPackage="com.elleng.usbdebug"
            android:targetClass="com.elleng.usbdebug.MainActivity" />
    </shortcut>

</shortcuts>
