<?xml version="1.0" encoding="utf-8"?>
<!-- 联动应用行右侧的操作按钮（作为 Preference 的 widgetLayout inflate）。
     两项操作：
       - btn_app_open「打开」：仅启动该应用（不动调试开关）；
       - btn_app_shortcut「快捷」：在桌面生成该应用的原生快捷方式
         （点了会关调试并联动跳到它，等价于一次「联动打开」）。
     整行点击 = 联动打开（关调试 + 跳到它），见 MainActivity.wireAppRow。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <Button
        android:id="@+id/btn_app_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/linkage_btn_open"
        android:textSize="12sp"
        android:textColor="@color/colorAccent"
        android:background="?android:attr/selectableItemBackgroundBorderless" />

    <Button
        android:id="@+id/btn_app_shortcut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/linkage_btn_shortcut"
        android:textSize="12sp"
        android:textColor="@color/colorAccent"
        android:background="?android:attr/selectableItemBackgroundBorderless" />

</LinearLayout>
