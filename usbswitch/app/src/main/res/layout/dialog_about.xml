<?xml version="1.0" encoding="utf-8"?>
<!-- 「关于」弹窗内容视图（非系统原生 AlertDialog 的纯文字 message，改为结构化布局）：
     顶部：左侧 app logo（占右侧两行高度），右侧两行 = 第一行 app 名称 + 版本号、第二行包名；
     分隔线后：第三行构建时间、第四行授权模式。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="8dp">

    <!-- 顶部：左侧 logo（占两行）+ 中间两行文字 + 右侧信息图标（与左 logo 对应） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/about_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 第一行：app 名称 + 版本号 -->
            <TextView
                android:id="@+id/about_name_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 第二行：包名 -->
            <TextView
                android:id="@+id/about_package"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 右侧信息图标：尺寸=单行文字字号(18dp)，与左侧 logo 对应；点击跳转仓库 -->
        <ImageView
            android:id="@+id/about_info"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="12dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/about_info_desc"
            android:src="@drawable/ic_info"
            android:tint="?android:attr/textColorSecondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="?android:attr/listDivider" />

    <!-- 第三行：构建时间 -->
    <TextView
        android:id="@+id/about_build_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp" />

    <!-- 第四行：授权模式 -->
    <TextView
        android:id="@+id/about_auth_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp" />

</LinearLayout>
